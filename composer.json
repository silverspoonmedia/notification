{
    "name": "silverspoonmedia/notification",
    "description": "Silverspoon core domain package: in-app notification engine (bell + history).",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "homepage": "https://github.com/silverspoonmedia/notification",
    "support": {
        "source": "https://github.com/silverspoonmedia/notification"
    },
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "silverspoonmedia/platform": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Domain\\Notification\\": "src/",
            "App\\Domain\\Notification\\Database\\Factories\\": "database/factories/",
            "App\\Domain\\Notification\\Database\\Seeders\\": "database/seeders/",
            "App\\Domain\\Notification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Domain\\Notification\\NotificationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
